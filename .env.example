# ==============================================================================
# Pathshala-Pro Environment Configuration Template
# ==============================================================================

# PostgreSQL Connection Strings (Neon / Supabase / AWS RDS)
# 1. DATABASE_URL: Pooled connection string for serverless API queries
DATABASE_URL="postgresql://username:password@ep-sample-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"

# 2. DIRECT_URL: Direct unpooled connection string for Prisma migrations & schema push
DIRECT_URL="postgresql://username:password@ep-sample.region.aws.neon.tech/neondb?sslmode=require"

# Neon API key (optional — enables branch management via CLI/MCP)
NEON_API_KEY="your-neon-api-key"

# Upstash Redis (distributed rate-limit / dedupe) — required for Vercel/serverless
# Get from https://console.upstash.com/redis (or Vercel KV auto-injects KV_REST_API_URL/_TOKEN)
UPSTASH_REDIS_REST_URL="https://your-upstash-redis-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-secure-random-string"

# Cloudflare R2 / AWS S3 Object Storage (PDF vouchers, student photos, homework)
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-cloudflare-r2-access-key"
R2_SECRET_ACCESS_KEY="your-cloudflare-r2-secret-key"
R2_BUCKET_NAME="pathshala-pro-storage"
R2_PUBLIC_DOMAIN="https://cdn.yourdomain.com"

# App Public Variables
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Pathshala Pro"
NEXT_PUBLIC_APP_DESCRIPTION="Enterprise School Management ERP Platform"

# Platform SuperAdmin / Host Owner (Comma-separated list of emails with global SaaS command center access)
PLATFORM_OWNER_EMAILS="superadmin@pathshalapro.com,owner@pathshalapro.com"
