# PostgreSQL connection string
DATABASE_URL="postgresql://username:password@localhost:5432/pathshala-pro?schema=public"

# Neon API key (optional — enables branch management via CLI/MCP)
NEON_API_KEY="your-neon-api-key"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-secure-random-string"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Pathshala Pro"
NEXT_PUBLIC_APP_DESCRIPTION="A platform for students to learn and grow"
