# PostgreSQL connection string
DATABASE_URL="postgresql://username:password@localhost:5432/pathshala-pro?schema=public"

# Neon API key (optional — enables branch management via CLI/MCP)
NEON_API_KEY="your-neon-api-key"

# Upstash Redis (distributed rate-limit / dedupe) — required for Vercel/serverless
# Get from https://console.upstash.com/redis  (or Vercel KV auto-injects KV_REST_API_URL/_TOKEN)
UPSTASH_REDIS_REST_URL="https://your-upstash-redis-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"
# Vercel KV aliases (auto-injected if you add Vercel KV integration)
# KV_REST_API_URL=""
# KV_REST_API_TOKEN=""

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-secure-random-string"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Pathshala Pro"
NEXT_PUBLIC_APP_DESCRIPTION="A platform for students to learn and grow"

# Platform SuperAdmin / Host Owner (Comma-separated list of emails with global SaaS command center access)
PLATFORM_OWNER_EMAILS="superadmin@pathshalapro.com,owner@pathshalapro.com"
