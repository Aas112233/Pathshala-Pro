generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Tenant {
  id                 String  @id @default(cuid())
  tenantId           String  @unique
  name               String
  address            String
  subscriptionStatus String  @default("TRIAL")
  subscriptionPlan   String  @default("STARTER") // STARTER | PRO | ENTERPRISE | CUSTOM
  featureFlags       Json? // { hostel:true, transport:false, library:true, ... }
  fiscalYearStart    Int     @default(1)
  logoUrl            String?
  phone              String?
  email              String?

  // School Settings
  schoolCode      String?
  establishedYear Int?
  motto           String?
  website         String?

  // Financial Settings
  currency       String @default("BDT")
  currencySymbol String @default("৳")
  taxRate        Float  @default(0)

  // Date & Time Settings
  dateFormat     String @default("DD/MM/YYYY")
  timeFormat     String @default("24h")
  timezone       String @default("Asia/Dhaka")
  firstDayOfWeek String @default("sunday")

  // Academic Settings
  academicYearStart String @default("january")
  gradingSystem     String @default("GPA")
  curriculum        String @default("NCTB") // NCTB | CBSE | FBISE
  maxGracePerSubject Float @default(5)
  maxGracePerStudent Float @default(10)
  gpaScale          Json? // optional override of default bands

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                 User[]
  studentProfiles       StudentProfile[]
  academicYears         AcademicYear[]
  timetables            Timetable[]
  feeVouchers           FeeVoucher[]
  transactions          Transaction[]
  classFeeStructures    ClassFeeStructure[]
  studentFeeConcessions StudentFeeConcession[]
  staffProfiles         StaffProfile[]
  salaryLedgers         SalaryLedger[]
  attendances           Attendance[]
  examResults           ExamResult[]
  classes               Class[]
  groups                Group[]
  sections              Section[]
  subjects              Subject[]
  exams                 Exam[]
  examSubjects          ExamSubject[]
  questions             Question[]
  questionPapers        QuestionPaper[]
  promotionRules        PromotionRule[]
  classPromotions       ClassPromotion[]
  classSubjects         ClassSubject[]
  auditLogs             AuditLog[]
  expenseCategories     ExpenseCategory[]
  expenses              Expense[]
  bankAccounts          BankAccount[]
  notices               Notice[]
  enquiries             Enquiry[]
  transportVehicles     TransportVehicle[]
  transportRoutes       TransportRoute[]
  transportAllocations  TransportAllocation[]
  books                 Book[]
  bookIssues            BookIssue[]
  homeworks             Homework[]
  homeworkSubmissions   HomeworkSubmission[]
  leaveApplications     LeaveApplication[]
  inventoryItems        InventoryItem[]
  inventoryTransactions InventoryTransaction[]
  hostels               Hostel[]
  hostelRooms           HostelRoom[]
  hostelAllocations     HostelAllocation[]
  certificates          Certificate[]
  walletLedgers         StudentWalletLedger[]
  healthRecords         HealthRecord[]
  parentStudentLinks    ParentStudentLink[]
  academicSessions      StudentAcademicSession[]
  graceLedgers          GraceMarkLedger[]
  examComponentResults  ExamComponentResult[]
  subjectComponents     SubjectAssessmentComponent[]
  fiscalYears           FiscalYear[]
  financialPeriods      FinancialPeriod[]
  chartOfAccounts       ChartOfAccount[]
  journalEntries        JournalEntry[]
  journalLineItems      JournalLineItem[]
  tenantVoucherSequences TenantVoucherSequence[]
  feeHeads              FeeHead[]
  feeInvoiceItems       FeeInvoiceItem[]
  teacherSubstitutions  TeacherSubstitution[]
  academicHolidays      AcademicHoliday[]
  admissionApplications AdmissionApplication[]
  applicantDocuments    ApplicantDocument[]
  vehicleExpenseLogs    VehicleExpenseLog[]
  subscription          TenantSubscription?
  featureOverride       TenantFeatureOverride?
}

model User {
  id               String    @id @default(cuid())
  tenantId         String
  email            String
  name             String
  role             String    @default("CLERK")
  accessLevel      Int       @default(7) // 1=SCHOOL_ADMIN .. 7=STUDENT (principal hierarchy)
  permissions      Json?
  hash             String
  isActive         Boolean   @default(true)
  staffProfileId   String?
  studentProfileId String?  @unique
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant                Tenant                 @relation(fields: [tenantId], references: [tenantId])
  transactions          Transaction[]
  attendances           Attendance[]           @relation("MarkedBy")
  decidedPromotions     ClassPromotion[]
  staff                 StaffProfile[]
  recordedExpenses      Expense[]
  issuedBookIssues      BookIssue[]
  createdHomeworks      Homework[]
  inventoryTransactions InventoryTransaction[]
  approvedLeaves        LeaveApplication[]
  issuedCertificates    Certificate[]
  enquiries             Enquiry[]
  parentLinks           ParentStudentLink[]    @relation("ParentUser")
  studentProfile        StudentProfile?        @relation("StudentUser", fields: [studentProfileId], references: [id])
  approvedComponentGrace ExamComponentResult[] @relation("GraceApprovedBy")
  approvedExamGrace      ExamResult[]         @relation("ExamGraceApprovedBy")
  graceLedgers           GraceMarkLedger[]    @relation("GraceLedgerApprover")

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([email])
}

model StudentProfile {
  id                String    @id @default(cuid())
  tenantId          String
  studentId         String
  rollNumber        String
  profilePictureUrl String?
  firstName         String
  lastName          String
  firstNameBn       String?
  lastNameBn        String?
  guardianName      String
  guardianContact   String
  guardianEmail     String?
  fatherName        String?
  motherName        String?
  emergencyContact  String?
  bloodGroup        String?
  birthCertificateNo String?
  dateOfBirth       DateTime?
  gender            String?
  address           String?
  classId           String?
  groupId           String?
  sectionId         String?
  status            String    @default("ACTIVE")
  admissionDate     DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant               Tenant                @relation(fields: [tenantId], references: [tenantId])
  class                Class?                @relation(fields: [classId], references: [id])
  group                Group?                @relation(fields: [groupId], references: [id])
  section              Section?              @relation(fields: [sectionId], references: [id])
  feeVouchers          FeeVoucher[]
  attendances          Attendance[]
  examResults          ExamResult[]
  promotions           ClassPromotion[]
  bookIssues           BookIssue[]
  transportAllocations TransportAllocation[]
  homeworkSubmissions  HomeworkSubmission[]
  leaveApplications    LeaveApplication[]
  enquiries            Enquiry[]
  hostelAllocations    HostelAllocation[]
  certificates         Certificate[]
  healthRecords        HealthRecord[]
  parentLinks          ParentStudentLink[]
  linkedUser           User?                 @relation("StudentUser")
  academicSessions     StudentAcademicSession[]
  concessions          StudentFeeConcession[]
  walletLedgers         StudentWalletLedger[]

  @@unique([tenantId, studentId])
  @@index([tenantId, rollNumber])
  @@index([tenantId, status])
  @@index([tenantId, classId, status])
  @@index([tenantId, sectionId])
  @@index([tenantId, groupId])
  @@index([tenantId, createdAt])
}

model AcademicYear {
  id        String   @id @default(cuid())
  tenantId  String
  yearId    String
  label     String
  startDate DateTime
  endDate   DateTime
  isClosed  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant                     Tenant           @relation(fields: [tenantId], references: [tenantId])
  feeVouchers                FeeVoucher[]
  salaryLedgers              SalaryLedger[]
  examResults                ExamResult[]
  exams                      Exam[]
  promotionRules             PromotionRule[]
  classFeeStructures         ClassFeeStructure[]
  fromAcademicYearPromotions ClassPromotion[] @relation("FromAcademicYearPromotions")
  toAcademicYearPromotions   ClassPromotion[] @relation("ToAcademicYearPromotions")
  timetables                 Timetable[]
  academicSessions           StudentAcademicSession[]
  teacherSubstitutions       TeacherSubstitution[]
  academicHolidays           AcademicHoliday[]
  admissionApplications      AdmissionApplication[]
  questionPapers             QuestionPaper[]
  attendances                Attendance[]

  @@unique([tenantId, yearId])
  @@index([tenantId])
}

model FeeVoucher {
  id               String   @id @default(cuid())
  tenantId         String
  voucherId        String
  studentProfileId String
  academicYearId   String
  fiscalYearId     String?
  financialPeriodId String?
  feeType          String
  billingMonth     Int?
  billingYear      Int?
  baseAmount       Float
  discountAmount   Float    @default(0)
  arrears          Float    @default(0)
  lateFine         Float    @default(0)
  totalDue         Float
  amountPaid       Float    @default(0)
  balance          Float
  dueDate          DateTime
  status           String   @default("PENDING")
  journalEntryId   String?
  voidedAt         DateTime?
  voidedById       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant         Tenant         @relation(fields: [tenantId], references: [tenantId])
  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id])
  academicYear   AcademicYear   @relation(fields: [academicYearId], references: [id])
  transactions   Transaction[]

@@unique([tenantId, voucherId])
@@unique([tenantId, studentProfileId, academicYearId, feeType, billingYear, billingMonth])
  @@index([tenantId, studentProfileId])
  @@index([tenantId, status])
  @@index([tenantId, academicYearId])
  @@index([tenantId, createdAt])
  @@index([tenantId, dueDate]) // Added for fee reminder queries
}

model Transaction {
  id               String   @id @default(cuid())
  tenantId         String
  transactionId    String
  feeVoucherId     String
  amountPaid       Float
  appliedToInvoice Float    @default(0)
  excessToWallet   Float    @default(0)
  paymentMethod    String
  receiptNumber    String
  journalEntryId   String?
  collectedById    String
  note             String?
  isVoided         Boolean  @default(false)
  voidedAt         DateTime?
  timestamp        DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant      Tenant     @relation(fields: [tenantId], references: [tenantId])
  feeVoucher  FeeVoucher @relation(fields: [feeVoucherId], references: [id])
  collectedBy User       @relation(fields: [collectedById], references: [id])

  @@unique([tenantId, transactionId])
  @@unique([tenantId, receiptNumber])
  @@index([tenantId, timestamp])
  @@index([tenantId, feeVoucherId])
  @@index([tenantId, collectedById])
}

model ClassFeeStructure {
  id              String       @id @default(cuid())
  tenantId        String
  academicYearId  String
  classId         String
  tuitionFee      Float        @default(0)
  labFee          Float        @default(0)
  computerFee     Float        @default(0)
  examFee         Float        @default(0)
  sportsFee       Float        @default(0)
  libraryFee      Float        @default(0)
  otherFee        Float        @default(0)
  totalMonthlyFee Float        @default(0)
  billingCycle    String       @default("MONTHLY") // MONTHLY | QUARTERLY | BI_ANNUAL | ANNUAL
  notes           String?
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [tenantId])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  class        Class        @relation(fields: [classId], references: [id])

  @@unique([tenantId, academicYearId, classId])
  @@index([tenantId, academicYearId])
  @@index([tenantId, classId])
}

model StudentFeeConcession {
  id               String         @id @default(cuid())
  tenantId         String
  studentProfileId String
  concessionType   String         // SIBLING | STAFF_CHILD | MERIT | NEED_BASED | CUSTOM
  discountType     String         // PERCENTAGE | FIXED_AMOUNT
  discountValue    Float
  appliesToHead    String         @default("TUITION")
  priority         Int            @default(10)
  validFrom        DateTime?
  validUntil       DateTime?
  reason           String?
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  tenant         Tenant         @relation(fields: [tenantId], references: [tenantId])
  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id])

  @@unique([tenantId, studentProfileId, concessionType])
  @@index([tenantId])
  @@index([tenantId, concessionType])
}

model StaffProfile {
  id                String    @id @default(cuid())
  tenantId          String
  staffId           String
  userId            String?
  firstName         String
  lastName          String
  firstNameBn       String?
  lastNameBn        String?
  department        String
  designation       String
  baseSalary        Float
  hireDate          DateTime
  joiningDate       DateTime?
  phone             String?
  email             String?
  gender            String?
  dateOfBirth       DateTime?
  qualification     String?
  address           String?
  profilePictureUrl String?
  driveFileId       String?
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant            Tenant             @relation(fields: [tenantId], references: [tenantId])
  user              User?              @relation(fields: [userId], references: [id])
  salaryLedgers     SalaryLedger[]
  attendances       Attendance[]
  bookIssues        BookIssue[]
  leaveApplications LeaveApplication[]
  timetables        Timetable[]
  originalSubstitutions TeacherSubstitution[] @relation("OriginalStaffSubstitution")
  substituteAssignments TeacherSubstitution[] @relation("SubstituteStaffAssignment")

  @@unique([tenantId, staffId])
  @@index([tenantId])
  @@index([userId])
}

model SalaryLedger {
  id             String    @id @default(cuid())
  tenantId       String
  staffProfileId String
  transactionId  String?   // Link to corresponding payment transaction
  academicYearId String
  month          Int
  year           Int
  // Legacy floats kept for migration — new Decimal fields are source of truth
  baseSalary     Float // deprecated: use grossSalary breakdown
  deductions     Float     @default(0)
  advances       Float     @default(0)
netPayable Decimal @db.Decimal(15,2)
  paidAmount     Float     @default(0)
  // New Decimal-precise payroll breakdown (15,2)
  grossSalary       Decimal? @db.Decimal(15,2)
  totalEarnings     Decimal? @db.Decimal(15,2)
  totalDeductions   Decimal? @db.Decimal(15,2)
  lopDays           Float?   // unpaid days (attendance + proration)
  lopAmount         Decimal? @db.Decimal(15,2)
  pfAmount          Decimal? @db.Decimal(15,2)
  taxAmount         Decimal? @db.Decimal(15,2)
  loanRecovery      Decimal? @db.Decimal(15,2)
  daysInMonth       Int?
  payableDays       Int?
  isProrated        Boolean  @default(false)
  earningsBreakdown Json? // { base, hra, medical, transport, special }
  deductionsBreakdown Json? // { lop, pf, tax, loan }
  status         String    @default("PENDING")
  paidAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [tenantId])
  staffProfile StaffProfile @relation(fields: [staffProfileId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  @@index([tenantId, staffProfileId])
  @@index([tenantId, year, month])
  @@unique([tenantId, staffProfileId, year, month]) // Prevent duplicate ledgers per staff per month
  @@index([tenantId, academicYearId])
  @@index([tenantId, transactionId])
  @@unique([tenantId, academicYearId, staffProfileId, month, year])
}

model Attendance {
  id                    String    @id @default(cuid())
  tenantId              String
  studentProfileId      String?
  staffProfileId        String?
  academicYearId        String?
  date                  DateTime
  status                String    // PRESENT, ABSENT, LATE, HALF_DAY, EXCUSED, HOLIDAY
  checkInTime           DateTime?
  checkOutTime          DateTime?
  lateMinutes           Int       @default(0)
  earlyDepartureMinutes Int       @default(0)
  note                  String?
  markedById            String
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [tenantId])
  studentProfile StudentProfile? @relation(fields: [studentProfileId], references: [id])
  staffProfile   StaffProfile?   @relation(fields: [staffProfileId], references: [id])
  academicYear  AcademicYear?   @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  markedBy       User            @relation("MarkedBy", fields: [markedById], references: [id])

  @@index([tenantId, date])
  @@index([tenantId, studentProfileId])
  @@index([tenantId, staffProfileId])
  @@index([tenantId, markedById])
  @@index([tenantId, studentProfileId, date]) // Added for student-day lookups
  @@index([tenantId, academicYearId, date])
  @@index([tenantId, academicYearId, studentProfileId, date])
  @@index([tenantId, academicYearId, staffProfileId, date])
}

// Exam & Subject Models
model Subject {
  id        String   @id @default(cuid())
  tenantId  String
  subjectId String
  name      String
  code      String
  category  String // "COMPULSORY", "ELECTIVE", "OPTIONAL"
  maxMarks  Float    @default(100)
  passMarks Float    @default(33)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [tenantId])
  examResults   ExamResult[]
  examSubjects  ExamSubject[]
  classSubjects  ClassSubject[]
  timetables     Timetable[]
  homeworks      Homework[]
  questions      Question[]
  questionPapers QuestionPaper[]

  @@unique([tenantId, subjectId])
  @@index([tenantId])
}

// Class-Subject Mapping
model ClassSubject {
  id           String   @id @default(cuid())
  tenantId     String
  classId      String
  subjectId    String
  isCompulsory Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [tenantId])
  class   Class   @relation(fields: [classId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])

  @@unique([tenantId, classId, subjectId])
  @@index([tenantId, classId])
  @@index([tenantId, subjectId])
}

model Exam {
  id             String   @id @default(cuid())
  tenantId       String
  examId         String
  academicYearId String
  name           String // "Mid-Term", "Final", "Unit Test"
  type           String // "MID_TERM", "FINAL", "UNIT_TEST", "ANNUAL"
  startDate      DateTime
  endDate        DateTime
  isPublished    Boolean  @default(false)
  totalMarks     Float    @default(100)
  passPercentage Float    @default(33)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [tenantId])
  academicYear AcademicYear  @relation(fields: [academicYearId], references: [id])
  subjects       ExamSubject[]
  results        ExamResult[]
  questionPapers QuestionPaper[]

  @@unique([tenantId, examId])
  @@index([tenantId, academicYearId])
  @@index([tenantId, type])
}

model ExamSubject {
  id        String   @id @default(cuid())
  tenantId  String
  examId    String
  subjectId String
  maxMarks  Float
  passMarks Float
  createdAt DateTime @default(now())

  tenant     Tenant                       @relation(fields: [tenantId], references: [tenantId])
  exam       Exam                         @relation(fields: [examId], references: [id])
  subject    Subject                      @relation(fields: [subjectId], references: [id])
  components SubjectAssessmentComponent[]

  @@unique([tenantId, examId, subjectId])
  @@index([tenantId, examId])
  @@index([tenantId, subjectId])
}

model ExamResult {
  id               String   @id @default(cuid())
  tenantId         String
  studentProfileId String
  academicYearId   String
  examId           String
  subjectId        String
  maxMarks         Float
  obtainedMarks    Float
  percentage       Float
  grade            String
  gradePoint       Float
  status           String // "PASS", "FAIL", "ABSENT"
  remarks          String?
  reExamAllowed    Boolean  @default(false)
  reExamMarks      Float?
  reExamGrade      String?
  reExamStatus     String? // "PASS", "FAIL"
  // Lock & grace audit
  isLocked            Boolean @default(false)
  originalObtained    Float?
  graceMarksGiven     Float   @default(0)
  graceReason         String? @db.Text
  graceApprovedById   String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant         Tenant         @relation(fields: [tenantId], references: [tenantId])
  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id])
  academicYear   AcademicYear   @relation(fields: [academicYearId], references: [id])
  exam           Exam           @relation(fields: [examId], references: [id])
  subject        Subject        @relation(fields: [subjectId], references: [id])
  graceApprovedBy User?         @relation("ExamGraceApprovedBy", fields: [graceApprovedById], references: [id])
  componentResults ExamComponentResult[]
  graceLedgers     GraceMarkLedger[]

  @@unique([tenantId, studentProfileId, examId, subjectId])
  @@index([tenantId, studentProfileId])
  @@index([tenantId, examId])
  @@index([tenantId, academicYearId])
  @@index([tenantId, subjectId])
  @@index([tenantId, createdAt])
  @@index([tenantId, isLocked])
}

// Question Bank & Question Paper Models
model Question {
  id            String   @id @default(cuid())
  tenantId      String
  classId       String
  subjectId     String
  chapter       String?
  topic         String?
  type          String   // "MCQ" | "SHORT" | "DESCRIPTIVE" | "CREATIVE_NCTB" | "TRUE_FALSE" | "FILL_BLANK"
  difficulty    String   @default("MEDIUM") // "EASY" | "MEDIUM" | "HARD"
  bloomLevel    String?  // "KNOWLEDGE" | "UNDERSTANDING" | "APPLICATION" | "ANALYSIS"
  questionText  String   @db.Text
  stimulus      String?  @db.Text // Passage/Context/উদ্দীপক for Comprehension or Creative Questions
  options       Json?    // [{ id: "A", text: "...", isCorrect: true }]
  subQuestions  Json?    // [{ label: "a", text: "...", marks: 1 }, { label: "b", text: "...", marks: 2 }]
  correctAnswer String?  @db.Text
  explanation   String?  @db.Text
  marks         Float    @default(1)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [tenantId])
  class   Class   @relation(fields: [classId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])

  @@index([tenantId, classId, subjectId])
  @@index([tenantId, type])
  @@index([tenantId, difficulty])
}

model QuestionPaper {
  id              String   @id @default(cuid())
  tenantId        String
  paperId         String
  title           String
  code            String?  // e.g. "QP-MATH-10-01"
  academicYearId  String
  classId         String
  subjectId       String
  examId          String?
  totalMarks      Float    @default(100)
  durationMinutes Int      @default(180)
  instructions    String?  @db.Text
  sections        Json     // Array of sections: [{ id: "sec-1", title: "Section A: Multiple Choice", instructions: "...", marks: 20, questionIds: [...] }]
  status          String   @default("DRAFT") // "DRAFT" | "READY" | "PUBLISHED" | "ARCHIVED"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [tenantId])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  class        Class        @relation(fields: [classId], references: [id])
  subject      Subject      @relation(fields: [subjectId], references: [id])
  exam         Exam?        @relation(fields: [examId], references: [id])

  @@unique([tenantId, paperId])
  @@index([tenantId, classId, subjectId])
  @@index([tenantId, status])
}

// Promotion Models
model PromotionRule {
  id                        String   @id @default(cuid())
  tenantId                  String
  academicYearId            String
  classId                   String
  minimumAttendance         Float    @default(75)
  minimumOverallPercentage  Float    @default(40)
  minimumPerSubject         Float    @default(33)
  maxFailedSubjects         Int      @default(0)
  allowConditionalPromotion Boolean  @default(false)
  autoPromote               Boolean  @default(true)
  nextClassId               String?
  isActive                  Boolean  @default(true)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [tenantId])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  class        Class        @relation(fields: [classId], references: [id])

