  academicYear   AcademicYear   @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  class          Class          @relation(fields: [classId], references: [id], onDelete: Restrict)
  section        Section?       @relation(fields: [sectionId], references: [id])
  group          Group?         @relation(fields: [groupId], references: [id])

  @@unique([tenantId, studentProfileId, academicYearId])
  @@unique([tenantId, academicYearId, classId, rollNumber])
  @@index([tenantId, academicYearId, classId])
  @@index([tenantId, promotionStatus])
}

model GraceMarkLedger {
  id                    String   @id @default(cuid())
  tenantId              String
  examComponentResultId String?
  examResultId          String?
  originalMarks         Float
  graceMarks            Float
  reason                String   @db.Text
  approvedById          String
  createdAt             DateTime @default(now())

  tenant              Tenant               @relation(fields: [tenantId], references: [tenantId])
  examComponentResult ExamComponentResult? @relation(fields: [examComponentResultId], references: [id], onDelete: Cascade)
  examResult          ExamResult?          @relation(fields: [examResultId], references: [id], onDelete: Cascade)
  approvedBy          User                 @relation("GraceLedgerApprover", fields: [approvedById], references: [id])

  @@index([tenantId, examResultId])
  @@index([tenantId, examComponentResultId])
  @@index([tenantId, approvedById])
}

model HealthRecord {
  id               String    @id @default(cuid())
  tenantId         String
  studentProfileId String
  bloodGroup       String?   // A+, A-, B+, B-, O+, O-, AB+, AB-
  allergies        String?   @db.Text
  chronicConditions String?  @db.Text
  medications      String?   @db.Text
  vaccinationJson  Json?     // [{ name, date, dose }]
  heightCm         Float?
  weightKg         Float?
  visionLeft       String?
  visionRight      String?
  lastCheckupDate  DateTime?
  remarks          String?   @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [tenantId])
  studentProfile StudentProfile  @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@unique([tenantId, studentProfileId])
  @@index([tenantId, bloodGroup])
}

// =========================================================================
// GENERAL LEDGER & FISCAL PERIOD CORE MODELS
// =========================================================================

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum NormalBalance {
  DEBIT
  CREDIT
}

enum VoucherType {
  JOURNAL
  PAYMENT
  RECEIPT
  SALES_FEE
  SALARY
  PURCHASE
  CONTRA
  CLOSING
}

enum PostingStatus {
  DRAFT
  POSTED
  VOIDED
}

model FiscalYear {
  id          String            @id @default(cuid())
  tenantId    String
  name        String            // e.g. "FY 2025-2026"
  startDate   DateTime
  endDate     DateTime
  isClosed    Boolean           @default(false)
  closedAt    DateTime?
  closedById  String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  tenant      Tenant            @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  periods     FinancialPeriod[]
  journalEntries JournalEntry[]

  @@unique([tenantId, name])
  @@index([tenantId, isClosed])
}

model FinancialPeriod {
  id           String       @id @default(cuid())
  tenantId     String
  fiscalYearId String
  periodNumber Int          // 1 to 12 (Months)
  name         String       // "July 2025", "August 2025"
  startDate    DateTime
  endDate      DateTime
  isClosed     Boolean      @default(false)
  closedAt     DateTime?

  tenant       Tenant       @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  fiscalYear   FiscalYear   @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)
  journalEntries JournalEntry[]

  @@unique([tenantId, fiscalYearId, periodNumber])
  @@index([tenantId, isClosed])
}

model ChartOfAccount {
  id              String           @id @default(cuid())
  tenantId        String
  code            String           // "1010", "1030", "2020", "4010", "5010", etc.
  name            String           // "Main Bank Account", "Tuition Revenue", etc.
  accountType     AccountType
  normalBalance   NormalBalance
  parentAccountId String?
  isSystem        Boolean          @default(false)
  isActive        Boolean          @default(true)
  currency        String           @default("PKR")

  tenant          Tenant           @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  parentAccount   ChartOfAccount?  @relation("AccountHierarchy", fields: [parentAccountId], references: [id])
  childAccounts   ChartOfAccount[] @relation("AccountHierarchy")
  journalLines    JournalLineItem[]

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, accountType])
}

model JournalEntry {
  id                String          @id @default(cuid())
  tenantId          String
  entryNumber       String          // e.g. "JV-2026-000001"
  voucherType       VoucherType     @default(JOURNAL)
  postingStatus     PostingStatus   @default(POSTED)
  postingDate       DateTime        @default(now())
  narration         String
  reference         String?
  totalDebit        Decimal         @db.Decimal(15, 2)
  totalCredit       Decimal         @db.Decimal(15, 2)
  
  fiscalYearId      String?
  financialPeriodId String?
  createdById       String

  tenant            Tenant          @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  fiscalYear        FiscalYear?     @relation(fields: [fiscalYearId], references: [id])
  financialPeriod   FinancialPeriod? @relation(fields: [financialPeriodId], references: [id])
  lineItems         JournalLineItem[]

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([tenantId, entryNumber])
  @@index([tenantId, postingDate])
  @@index([tenantId, voucherType])
}

model JournalLineItem {
  id             String         @id @default(cuid())
  tenantId       String
  journalEntryId String
  accountId      String
  debitAmount    Decimal        @default(0.00) @db.Decimal(15, 2)
  creditAmount   Decimal        @default(0.00) @db.Decimal(15, 2)
  narration      String?

  studentId      String?
  staffId        String?

  tenant         Tenant         @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  journalEntry   JournalEntry   @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account        ChartOfAccount @relation(fields: [accountId], references: [id])

  createdAt      DateTime       @default(now())

  @@index([tenantId, accountId])
  @@index([tenantId, journalEntryId])
}

model TenantVoucherSequence {
  id             String      @id @default(cuid())
  tenantId       String
  voucherType    VoucherType
  prefix         String      @default("JV")
  fiscalYear     Int
  current_number Int         @default(0)

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  tenant         Tenant      @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)

  @@unique([tenantId, voucherType, fiscalYear])
  @@index([tenantId, voucherType])
}

model FeeHead {
  id          String   @id @default(cuid())
  tenantId    String
  code        String   // "TUITION", "ADMISSION", "EXAM", "TRANSPORT", "HOSTEL", "LAB"
  name        String   // "Monthly Tuition Fee"
  accountCode String   @default("4010") // Target GL Revenue Account (4010, 4040, 4050, etc.)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  items  FeeInvoiceItem[]

  @@unique([tenantId, code])
}

model FeeInvoiceItem {
  id           String     @id @default(cuid())
  tenantId     String
  feeVoucherId String
  feeHeadId    String
  amount       Decimal    @db.Decimal(15, 2)
  description  String?

  tenant     Tenant     @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  feeHead    FeeHead    @relation(fields: [feeHeadId], references: [id])

  @@index([tenantId, feeVoucherId])
}

// =========================================================================
// TIMETABLE & TEACHER SUBSTITUTION MODELS
// =========================================================================

enum SubstitutionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

model TeacherSubstitution {
  id                String             @id @default(cuid())
  tenantId          String
  academicYearId    String
  timetableSlotId   String
  date              DateTime           @db.Date
  originalStaffId   String
  substituteStaffId String
  status            SubstitutionStatus @default(SCHEDULED)
  reason            String?            // "Medical Leave", "Emergency", "Official Duty"
  assignedById      String
  notes             String?

  tenant            Tenant             @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  academicYear      AcademicYear       @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  timetableSlot     Timetable          @relation(fields: [timetableSlotId], references: [id], onDelete: Cascade)
  originalStaff     StaffProfile       @relation("OriginalStaffSubstitution", fields: [originalStaffId], references: [id])
  substituteStaff   StaffProfile       @relation("SubstituteStaffAssignment", fields: [substituteStaffId], references: [id])

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([tenantId, timetableSlotId, date])
  @@index([tenantId, substituteStaffId, date])
  @@index([tenantId, originalStaffId, date])
}

// =========================================================================
// ACADEMIC HOLIDAYS & ATTENDANCE EXTENSIONS
// =========================================================================

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  EXCUSED
  HOLIDAY
}

enum HolidayType {
  PUBLIC
  RELIGIOUS
  TERM_BREAK
  EXAM_PREP
  EMERGENCY
}

model AcademicHoliday {
  id              String      @id @default(cuid())
  tenantId        String
  academicYearId  String
  title           String      // e.g., "Independence Day", "Eid-ul-Fitr", "Summer Break"
  holidayType     HolidayType @default(PUBLIC)
  startDate       DateTime    @db.Date
  endDate         DateTime    @db.Date
  affectsStaff    Boolean     @default(true)
  affectsStudents Boolean     @default(true)
  description     String?

  tenant          Tenant       @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  academicYear    AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([tenantId, academicYearId, startDate, endDate])
}

// =========================================================================
// STUDENT ADMISSION & APPLICANT DOCUMENT MODELS
// =========================================================================

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  ENROLLED
  REJECTED
  WITHDRAWN
}

enum DocumentType {
  BIRTH_CERTIFICATE
  TRANSFER_CERTIFICATE
  PREVIOUS_MARKSHEET
  GUARDIAN_NID
  MEDICAL_RECORD
  OTHER
}

model AdmissionApplication {
  id                 String            @id @default(cuid())
  tenantId           String
  applicationNumber  String            // e.g., "ADM-2026-00045"
  academicYearId     String
  targetClassId      String

  // Applicant Details
  firstName          String
  lastName           String
  dateOfBirth        DateTime          @db.Date
  gender             String            // MALE, FEMALE, OTHER
  bloodGroup         String?           // A+, A-, B+, B-, O+, O-, AB+, AB-
  birthCertificateNo String?
  nationality        String            @default("Bangladeshi")
  religion           String?

  // Family & Contact
  fatherName         String?
  motherName         String?
  guardianName       String
  guardianContact    String
  guardianEmail      String?
  emergencyContact   String
  presentAddress     String
  permanentAddress   String?

  status             ApplicationStatus @default(SUBMITTED)
  reviewedById       String?
  rejectionReason    String?
  notes              String?
  enrolledStudentId  String?           // Reference to StudentProfile once enrolled

  tenant             Tenant            @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  academicYear       AcademicYear      @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  documents          ApplicantDocument[]

  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@unique([tenantId, applicationNumber])
  @@index([tenantId, status, targetClassId])
}

model ApplicantDocument {
  id            String               @id @default(cuid())
  tenantId      String
  applicationId String
  documentType  DocumentType
  fileUrl       String               // Cloudflare R2 object URL or key
  fileName      String
  isVerified    Boolean              @default(false)
  verifiedById  String?
  verifiedAt    DateTime?

  tenant        Tenant               @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  application   AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  createdAt     DateTime             @default(now())

  @@index([tenantId, applicationId])
}

// =========================================================================
// CAMPUS AUXILIARY SERVICES & VEHICLE EXPENSE LOGS
// =========================================================================

enum BookIssueStatus {
  ISSUED
  RETURNED
  OVERDUE
  LOST
  DAMAGED
}

enum AllocationStatus {
  ACTIVE
  VACATED
  SUSPENDED
}

enum VehicleExpenseType {
  FUEL
  MAINTENANCE
  INSURANCE
  FITNESS_TAX
  OTHER
}

model VehicleExpenseLog {
  id              String             @id @default(cuid())
  tenantId        String
  vehicleId       String
  expenseType     VehicleExpenseType @default(FUEL)
  amount          Decimal            @db.Decimal(15, 2)
  odometerReading Int?
  expenseDate     DateTime           @default(now())
  description     String?
  paidFromCode    String             @default("1010") // 1010 Bank or 1020 Cash
  journalEntryId  String?
  recordedById    String

  tenant          Tenant             @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  vehicle         TransportVehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([tenantId, vehicleId, expenseDate])
}

// =========================================================================
// SUPERADMIN PLATFORM CONTROL PLANE, SUBSCRIPTIONS & FEATURE OVERRIDES
// =========================================================================

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  EXPIRED
  ARCHIVED
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  UNPAID
}

enum SuperAdminActionType {
  TENANT_STATUS_CHANGE
  QUOTA_UPDATE
  IMPERSONATION_START
  PLAN_CHANGE
  FEATURE_FLAG_CHANGE
  MAINTENANCE_TOGGLE
}

model SubscriptionPlan {
  id              String               @id @default(cuid())
  code            String               @unique // "STARTER", "GROWTH", "ENTERPRISE", "CUSTOM"
  name            String
  description     String?
  monthlyPrice    Decimal              @db.Decimal(15, 2)
  annualPrice     Decimal              @db.Decimal(15, 2)
  currency        String               @default("USD")

  maxStudents     Int                  @default(200)
  maxStaff        Int                  @default(20)
  maxStorageMb    Int                  @default(5120) // 5 GB
  maxSmsPerMonth  Int                  @default(500)

  features        Json                 // e.g. { "hostel": false, "transport": true, "payroll": true, "customGrading": true }
  isActive        Boolean              @default(true)

  subscriptions   TenantSubscription[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
}

model TenantSubscription {
  id                 String             @id @default(cuid())
  tenantId           String             @unique
  planId             String
  billingCycle       BillingCycle       @default(MONTHLY)
  status             SubscriptionStatus @default(TRIALING)
  currentPeriodStart DateTime           @default(now())
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean            @default(false)

  customMaxStudents  Int?
  customMaxStaff     Int?
  customMaxStorageMb Int?

  tenant             Tenant             @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  plan               SubscriptionPlan   @relation(fields: [planId], references: [id])

  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([tenantId, status])
}

model TenantFeatureOverride {
  id              String   @id @default(cuid())
  tenantId        String   @unique
  hasHostel       Boolean  @default(true)
  hasTransport    Boolean  @default(true)
  hasPayroll      Boolean  @default(true)
  hasBiometric    Boolean  @default(false)
  hasOnlinePay    Boolean  @default(true)
  hasCustomReport Boolean  @default(true)
  customModules   Json?    // Array of active custom feature tags

  tenant          Tenant   @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  updatedAt       DateTime @updatedAt
}

model SuperAdminActionLog {
  id              String               @id @default(cuid())
  adminUserId     String
  adminEmail      String
  targetTenantId  String?
  actionType      SuperAdminActionType
  ipAddress       String?
  userAgent       String?
  details         Json                 // Before & After state or metadata
  createdAt       DateTime             @default(now())

  @@index([adminUserId, actionType, createdAt])
  @@index([targetTenantId, createdAt])
}

model PlatformSetting {
  id              String   @id @default(cuid())
  key             String   @unique // "GLOBAL_MAINTENANCE_MODE", "PLATFORM_BROADCAST_BANNER", etc.
  value           Json
  description     String?
  lastUpdatedById String
  updatedAt       DateTime @updatedAt
}




