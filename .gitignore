# ==============================================================================
# PathshalaPro Production Git Ignore
# ==============================================================================

# --- Dependencies & Package Managers ---
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.yarn/cache
.yarn/install-state.gz
.yarn/unplugged
.yarn/link
.yarn/build-state.yml

# --- Next.js, Turbo & Build Artifacts ---
.next/
.next*/
out/
build/
dist/
.output/
.turbo/
.swc/
.cache/
build_output.txt
next-env.d.ts

# --- Environment Variables & Secrets ---
# Ignore all .env variants by default
.env
.env.*
.env*.local
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
.env.staging
.env.staging.local

# Whitelist safe example/template files
!.env.example
!.env.template
!.env.sample
!.env.local.example

# Certificates & Private Keys
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.keystore

# Cloud & Service Account Credentials
service-account*.json
google-credentials*.json
firebase-adminsdk*.json
aws-credentials*.json
*.secret
.credentials

# --- Databases & Local Storage ---
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
prisma/db/
prisma/*.db

# --- Media, Uploads & Runtime Storage ---
/public/uploads/
/public/static/
/storage/
/uploads/
/backups/
/dumps/

# --- Testing, Coverage & Reports ---
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/
playwright/.cache/
cypress/videos/
cypress/screenshots/
vitest.config.ts.timestamp-*

# --- Logs & Process Dumps ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Deployment Platforms ---
.vercel/
.serverless/
.sst/
.amplify/

# --- TypeScript ---
*.tsbuildinfo

# --- OS System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# --- Editor & IDE Files ---
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.sublime-workspace
*.sublime-project
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
*~

# --- AI Tools & Local Agent Data ---
.claude/
.opencode/
.gemini/
.agents/
.cursor/

# --- Temporary & Scratch Files ---
*.tmp
*.temp
*.bak
scratch/
.vercel
.env*
