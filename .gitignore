prisma/*.db

# --- Media, Uploads & Runtime Storage ---
/public/uploads/
/public/static/
/storage/
/uploads/
/backups/
/dumps/
# Keep folders but ignore contents
!**/.gitkeep

# --- Testing, Coverage & Reports ---
